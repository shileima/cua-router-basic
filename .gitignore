# Local runtime state (CODEX_HOME) — regenerated on first start
runtime/

# Vendor binaries (~735 MB) — extracted locally or downloaded from release
vendor/*
!vendor/README.md
!vendor/.gitkeep

# Release artifacts
dist/
*.tar.gz
*.tar.gz.sha256

# Intranet (Sankuai S3plus) publish tooling — touches the internal credential
# proxy, must not be committed. Install side (scripts/install-intranet.sh) is
# public download-only and stays tracked.
scripts/intranet/

# Intranet install marker (written at install time by install-intranet.sh)
.cua-intranet

# macOS / editor
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Process logs (daemon.sh defaults to /tmp; ignore if redirected here)
*.log

# Python bytecode caches (incl. sandbox-redirected PYTHONPYCACHEPREFIX output)
__pycache__/
*.pyc
.pycache/
